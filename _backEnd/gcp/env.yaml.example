# ==============================================================================
# Mifrufely Web — Google Cloud Run Environment Variables Template
# Copia este archivo a env.yaml y completa los valores reales
# NUNCA commitees env.yaml con credenciales reales
# ==============================================================================

APP_ENV: "production"
DEBUG: "false"
LOG_FORMAT: "json"
GCP_PROJECT_ID: "tu-gcp-project-id"
CLOUD_TASKS_QUEUE: "mifrufely-tasks"
CLOUD_TASKS_LOCATION: "us-central1"
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL: "mifrufely-backend-invoker@tu-gcp-project-id.iam.gserviceaccount.com"
FRONTEND_URL: "https://tu-frontend.vercel.app"
ALLOWED_ORIGINS: "https://tu-frontend.vercel.app,http://localhost:5173"
DATABASE_URL: "postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>/<DB>?sslmode=require"
SECRET_KEY: "genera-un-secreto-seguro-minimo-32-caracteres"
SMTP_HOST: "smtp.gmail.com"
SMTP_PORT: "587"
SMTP_USER: "tu-correo@gmail.com"
SMTP_PASSWORD: "tu-app-password-de-gmail"
SMTP_FROM: "tu-correo@gmail.com"
GOOGLE_CLIENT_ID: "tu-google-client-id.apps.googleusercontent.com"
CLOUDINARY_CLOUD_NAME: "tu-cloudinary-cloud-name"
CLOUDINARY_API_KEY: "tu-cloudinary-api-key"
CLOUDINARY_API_SECRET: "tu-cloudinary-api-secret"
JSONPE_API_TOKEN: "tu-jsonpe-token"
JSONPE_BASE_URL: "https://api.json.pe"
REDIS_URL: "memory://"
